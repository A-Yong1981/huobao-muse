# Local build label for the integrated app image.
HUOBAO_VERSION=muse-build

# Internal API address on the Compose network.
HUOBAO_API_BASE=http://app:5679/api/v1

# Set a unique long random value locally. Never commit the real token.
MUSE_BRIDGE_TOKEN=replace-with-a-long-random-token

# Explicit comma-separated Huobao drama IDs Muse may access. Empty denies all.
ALLOWED_DRAMA_IDS=

# Keep loopback unless an HTTPS reverse proxy runs on the same host.
MUSE_CONNECTOR_BIND=127.0.0.1
