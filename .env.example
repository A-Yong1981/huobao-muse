# Local build label for the integrated app image.
HUOBAO_VERSION=muse-build

# Internal API address on the Compose network.
HUOBAO_API_BASE=http://app:5679/api/v1

# Set a unique long random token locally. If exposed to the internet, use a long random token.
# After initial setup, rotate it in the web Settings page without rebuilding.
MUSE_BRIDGE_TOKEN=replace-with-a-long-random-token

# Optional comma-separated drama filter. Empty allows all dramas.
ALLOWED_DRAMA_IDS=

# Bind to the address targeted by the tunnel. Use 127.0.0.1 only if the tunnel targets localhost.
MUSE_CONNECTOR_BIND=127.0.0.1
MUSE_MCP_PUBLIC_URL=https://hb-mcp.aynas.de5.net/mcp

# PBKDF2-SHA256 hash for first OTP enrollment, formatted as hex_salt$hex_hash.
# Generate interactively as described in README; never commit the actual value.
WEB_AUTH_BOOTSTRAP_HASH=
